# clickbAIt — environment variables
# Copy this file to .env and fill in your keys.

# Required: Anthropic API key for Claude (song design chat)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Genius API token for lyrics lookup
# Get one at https://genius.com/api-clients
GENIUS_API_TOKEN=

# Note: Spotify is not currently used. Deezer + MusicBrainz handle metadata.
