{
  "name": "clickbait",
  "version": "0.1.0-beta.1",
  "type": "module",
  "files": [
    "src/",
    "assets/",
    "bin/",
    "dist/"
  ],
  "bin": {
    "clickbait-generate": "./bin/generate.mjs",
    "clickbait-teleprompter": "./bin/teleprompter.mjs",
    "clickbait-lookup": "./bin/lookup.mjs",
    "clickbait-bundle": "./bin/bundle.mjs"
  },
  "exports": {
    "./dsongl": "./src/core/dsongl/index.ts"
  },
  "workspaces": [
    "songs/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "song:init": "npx tsx src/build/init-song.ts",
    "song:build": "npx tsx src/build/generate.ts",
    "song:beats-unify": "npx tsx src/authoring/unify-beats-cli.ts",
    "song:chords-draft": "npx tsx src/authoring/chords-draft-cli.ts",
    "song:chart-questions": "npx tsx src/authoring/chart-questions-cli.ts",
    "song:chart-review": "npx tsx src/authoring/chart-review-cli.ts",
    "song:visuals-preview": "npx tsx src/visuals/preview-cli.ts",
    "song:media": "npx tsx src/visuals/media-cli.ts",
    "songs": "npx tsx scripts/songs.ts",
    "show:teleprompter": "npx tsx scripts/teleprompter.ts",
    "realign-all": "npx tsx scripts/realign-all.ts",
    "dev:bundle": "node scripts/build.mjs",
    "dev:skill": "npx tsx scripts/render-skill.ts",
    "dev:sandbox": "scripts/sandbox.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/nunjucks": "^3.2.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "nunjucks": "^3.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wireit": "^0.14.13"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "nodejs-whisper": "^0.2.9",
    "osc": "^2.4.5",
    "p5": "^2.3.4",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  }
}
