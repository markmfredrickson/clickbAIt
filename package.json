{
  "name": "clickbait",
  "version": "0.1.0-beta.1",
  "type": "module",
  "files": [
    "src/",
    "assets/",
    "bin/",
    "dist/"
  ],
  "bin": {
    "clickbait-generate": "./bin/generate.mjs",
    "clickbait-teleprompter": "./bin/teleprompter.mjs",
    "clickbait-lookup": "./bin/lookup.mjs",
    "clickbait-bundle": "./bin/bundle.mjs"
  },
  "exports": {
    "./dsongl": "./src/core/dsongl/index.ts"
  },
  "workspaces": [
    "songs/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "beats:unify": "npx tsx src/authoring/unify-beats-cli.ts",
    "lyrics:txt": "npx tsx src/authoring/lyrics-text-cli.ts",
    "scaffold": "npx tsx src/authoring/scaffold-cli.ts",
    "generate": "npx tsx src/build/generate.ts",
    "build:songs": "npx tsx scripts/build-songs.ts",
    "bundle": "npx tsx src/build/bundle.ts",
    "bundle:render": "npx tsx scripts/render-bundle.ts",
    "teleprompter": "npx tsx scripts/teleprompter.ts",
    "build:skill": "npx tsx scripts/render-skill.ts",
    "sandbox": "scripts/sandbox.sh",
    "demo": "./demo/render.sh --all",
    "demo:browser": "./demo/render.sh --browser-only",
    "demo:cli": "./demo/render.sh --cli-only",
    "demo:reaper": "./demo/render.sh --reaper-only",
    "beats:smooth": "npx tsx src/authoring/smooth-beats-cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/nunjucks": "^3.2.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "nunjucks": "^3.2.4",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wireit": "^0.14.13"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "nodejs-whisper": "^0.2.9",
    "osc": "^2.4.5",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  }
}
